# ===== Common =====
HF_DATASETS_CACHE=./data/cache/hf_datasets

# Local multimodal model inference through ms-swift.
MODEL_BACKEND=swift
LOCAL_MODEL_PATH=./model_cache/modelscope/models/OpenGVLab/InternVL2_5-78B
LOCAL_DEVICE_MAP=auto
LOCAL_TORCH_DTYPE=auto
LOCAL_ATTENTION_IMPL=
LOCAL_MAX_NEW_TOKENS=512
LOCAL_TEMPERATURE=0.0
LOCAL_MAX_RETRIES=1
LOCAL_RETRY_WAIT_SECONDS=5
SWIFT_MODEL_TYPE=internvl2_5
SWIFT_INFER_BACKEND=transformers
SWIFT_DEVICE_MAP=auto
SWIFT_TORCH_DTYPE=auto
SWIFT_MAX_TOKENS=512
SWIFT_TEMPERATURE=0.0
SWIFT_TOP_P=1.0
SWIFT_IMAGE_PLACEHOLDER=

# ===== Step 1: build YES/NO from the source dataset =====
DATASET_NAME=stochastic/random_streetview_images_pano_v0.0.2
FILTER_START_INDEX=0
FILTER_END_INDEX=5527
FILTER_BATCH_SIZE=30
FILTER_BUFFER_SIZE=30
FILTER_SLEEP_SECONDS=0
FILTER_DIST_THRESHOLD_KM=5
FILTER_YES_CHUNK_START_ID=0
FILTER_NO_CHUNK_START_ID=0
YES_DIR=./data/YES
NO_DIR=./data/NO

# ===== Step 2: build afterSAM masks from YES =====
YES_INPUT_DATASET_PATH=./data/YES
YES_AFTER_SAM_OUTPUT_DIR=./data/YES_NEW_afterSAM

# ===== Step 3: reevaluate masked images =====
AFTER_SAM_INPUT_DATASET_PATH=./data/YES_NEW_afterSAM
YES_MASK_OUTPUT_DIR=./data/YES_Mask
START_INDEX=0
END_INDEX=1030
BUFFER_SIZE=30
SLEEP_SECONDS=0
CHUNK_START_ID=0

# Optional: run split ranges with the same unified pipeline by setting prefixed keys.
# MASK1_YES_MASK_OUTPUT_DIR=./data/YES_Mask
# MASK1_START_INDEX=0
# MASK1_END_INDEX=1030
# MASK2_YES_MASK_OUTPUT_DIR=./data/YES_Mask
# MASK2_START_INDEX=1030
# MASK2_END_INDEX=2061

# ===== Step 4: select the target mask category =====
YES_MASK_INPUT_PATH=./data/YES_Mask
YES_MASK_SELECTED_OUTPUT_PATH=./data/YES_Mask_selected
SELECT_MASK_JSON_OUTPUT_PATH=./data/qwen_sft_alignment_dataset.json
SELECT_MASK_TAU=0.6
SELECT_MASK_PRIVACY_CAP_KM=100
SELECT_MASK_OVERWRITE=0

# ===== Step 5: export SFT JSONL =====
YES_REASON_DATASET_PATH=./data/YES
YES_MASK_SELECTED_DATASET_PATH=./data/YES_Mask_selected
TRAINSET_IMAGE_SAVE_DIR=./data/sft_images
TRAINSET_JSONL_OUTPUT_PATH=./data/train_cot.jsonl
